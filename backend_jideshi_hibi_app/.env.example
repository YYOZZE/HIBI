# 大模型（OpenAI 兼容接口：豆包/通义/OpenAI 等）
# 豆包 Pro（火山方舟）：使用 /api/v3/chat/completions 兼容接口，无需改后端代码
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_API_KEY=your_api_key_here
MODEL_ID=doubao-seed-2-0-pro-260215

# 服务端口（7861 与同机其他应用 7860 错开）
PORT=7861

# 数捷支付（服务增值）：见 https://www.shujiepay.com/doc/index.html
# 不配置时创建订单后返回本服 pay_page 说明页。密钥说明见项目内「服务增值支付说明.md」
# SHUJIEPAY_SUBMIT_URL=https://www.shujiepay.com/api/pay/submit   # SDK2 推荐
# SHUJIEPAY_DEFAULT_TYPE=alipay   # 可选：alipay/wxpay/qqpay/bank/jdpay
# SHUJIEPAY_NOTIFY_URL=https://你的域名/api/payment/notify
# SHUJIEPAY_RETURN_URL=https://你的域名/api/payment/pay_page
# SHUJIEPAY_MCH_ID=商户号
# 商户私钥：仅配置在服务器 .env（如 ECS /root/jideshi_hibi_backend/.env），PEM 全文，切勿提交到 Git
# SHUJIEPAY_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 平台公钥：从数捷商户后台获取，PEM 全文，用于回调验签
# SHUJIEPAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# HIBI_BASE_URL=http://121.41.6.21:7861

# 阿里云图形认证（登录/注册前置）
# 控制台方案表（hibi23h52 / hibi23hm2 / hibi23pg2 / hibi23az2 及 FG 编码）见项目根目录 阿里图片认证.md
# https://help.aliyun.com/zh/pnvs/developer-reference/graphical-authentication-server-integration
# https://help.aliyun.com/zh/pnvs/developer-reference/integrate-the-sdk-with-h5-pages
# 通用兜底（可不填，建议按平台分别配置）
# GRAPH_CAPTCHA_APP_ID=
# GRAPH_CAPTCHA_APP_KEY=
# 平台专用（优先级更高）
# GRAPH_CAPTCHA_WEB_APP_ID=
# GRAPH_CAPTCHA_WEB_APP_KEY=
# GRAPH_CAPTCHA_HARMONY_APP_ID=
# GRAPH_CAPTCHA_HARMONY_APP_KEY=
# GRAPH_CAPTCHA_IOS_APP_ID=
# GRAPH_CAPTCHA_IOS_APP_KEY=
# GRAPH_CAPTCHA_ANDROID_APP_ID=
# GRAPH_CAPTCHA_ANDROID_APP_KEY=
# Web 端 ct4.js 资源地址（前端拉起图形认证时使用）
# GRAPH_CAPTCHA_SDK_URL=https://你的静态域名/ct4.js

# 豆包语音转文字（助理语音输入）：火山引擎豆包语音 SAUC 控制台获取
# https://www.volcengine.com/docs/6561/1073925
# 推荐变量名（目标方案）：
# ASR_ENABLED=true
# ASR_APP_ID=
# ASR_TOKEN=
# ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
# ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# ASR_USER_UID=hibi_asr
# 是否带 X-Api-Connect-Id（官方 demo 无；默认 1 兼容旧部署，异常时可试 0）
# ASR_INCLUDE_CONNECT_ID=1
# 上传 WAV 时分片间隔（毫秒），默认 200
# ASR_SEGMENT_MS=200
#
# 兼容旧变量名（二选一即可）：
# ASR_APP_KEY=
# ASR_ACCESS_KEY=
